# OpenAI
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-5.5"
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# Ingestion source API keys (all optional - pipeline falls back to synthetic/mock data when absent)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_PLAY_PACKAGE_NAME="com.spotify.music"
APPLE_APP_ID="324684580"
APPLE_APP_STORE_COUNTRY="us"
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="spotify-voc-intel/1.0"
TWITTER_BEARER_TOKEN=""
YOUTUBE_API_KEY=""
YOUTUBE_VIDEO_IDS=""
NEWSAPI_API_KEY=""
GOOGLE_NEWS_RSS_QUERY="Spotify recommendations OR Spotify discovery"
MEDIUM_RSS_USERNAMES=""

# Notifications
SLACK_WEBHOOK_URL=""
NOTIFICATION_EMAIL_TO=""
RESEND_API_KEY=""

# Cron security
CRON_SECRET="dev-cron-secret-change-me"

# Observability
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

NODE_ENV="development"
