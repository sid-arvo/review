# Database
DATABASE_URL="postgresql://user:password@localhost:5432/spotify_voc?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/spotify_voc?schema=public"

# Redis / Queue
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
